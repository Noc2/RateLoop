{
  "name": "@rateloop/node-utils",
  "version": "0.1.0",
  "type": "module",
  "description": "Bounded Foundry V3 keystore loading for RateLoop Node services",
  "homepage": "https://github.com/Noc2/RateLoop/tree/main/packages/node-utils",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Noc2/RateLoop.git",
    "directory": "packages/node-utils"
  },
  "bugs": {
    "url": "https://github.com/Noc2/RateLoop/issues"
  },
  "keywords": [
    "rateloop",
    "node",
    "foundry",
    "keystore"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./keystore": {
      "types": "./dist/esm/keystore.d.ts",
      "import": "./dist/esm/keystore.js",
      "require": "./dist/cjs/keystore.js"
    },
    "./jcs": {
      "types": "./dist/esm/jcs.d.ts",
      "import": "./dist/esm/jcs.js",
      "require": "./dist/cjs/jcs.js"
    },
    "./drand": {
      "types": "./dist/esm/drand.d.ts",
      "import": "./dist/esm/drand.js",
      "require": "./dist/cjs/drand.js"
    },
    "./evm-signing-audit": {
      "types": "./dist/esm/evm-signing-audit.d.ts",
      "import": "./dist/esm/evm-signing-audit.js",
      "require": "./dist/cjs/evm-signing-audit.js"
    },
    "./platform-secret-evm-account": {
      "types": "./dist/esm/platform-secret-evm-account.d.ts",
      "import": "./dist/esm/platform-secret-evm-account.js",
      "require": "./dist/cjs/platform-secret-evm-account.js"
    }
  },
  "typesVersions": {
    "*": {
      "keystore": [
        "dist/esm/keystore.d.ts"
      ],
      "jcs": [
        "dist/esm/jcs.d.ts"
      ],
      "drand": [
        "dist/esm/drand.d.ts"
      ],
      "evm-signing-audit": [
        "dist/esm/evm-signing-audit.d.ts"
      ],
      "platform-secret-evm-account": [
        "dist/esm/platform-secret-evm-account.d.ts"
      ],
      "*": [
        "dist/esm/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "node ../../scripts/with-workspace-dist-lock.mjs \"node ../../scripts/clean-package-dist.mjs && yarn build:dist\"",
    "build:dist": "tsc -p tsconfig.json && node ../../scripts/fix-esm-extensions.mjs dist/esm && tsc -p tsconfig.cjs.json && node ../../scripts/write-cjs-package-json.mjs dist/cjs",
    "prepack": "yarn build",
    "test": "node ../../scripts/run-node-tests.mjs src",
    "check-types": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@noble/curves": "1.9.1",
    "@noble/hashes": "1.8.0",
    "viem": "2.39.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  }
}
